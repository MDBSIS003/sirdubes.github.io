digraph Alternatives { graph [rankdir=LR,bgcolor="white",pad=.3,nodesep=.35,ranksep=.55]; node [shape=box,style="rounded,filled",fillcolor="#edf5f7",fontname="DejaVu Sans",fontsize=10,color="#17364a"]; edge [fontname="DejaVu Sans",fontsize=9,color="#17766b"];
Controller -> Engine[label="Assess(draft, active programmes, questions)"];
Engine -> EachProgramme[label="foreach other active degree"];
EachProgramme -> Evaluate[label="same mandatory/average/interest checks"];
Evaluate -> Outcome[label="Strong / Possible / Not Eligible / More Info"];
Outcome -> Ranked[label="keep Strong/Possible only"];
Ranked -> Insert[label="outcome, score descending, name, ID"];
Insert -> TopFive[label="keep at most five"];
TopFive -> ResultForm[label="show reasons and score"];
TopFive -> Save[label="persist with selected result at final save"];
}