digraph ERD { graph [rankdir=LR,bgcolor="white",nodesep=.45,ranksep=1.2]; node [shape=plain,fontname="DejaVu Sans"]; edge [fontsize=9,color="#4d7683"];
AdvisorySession [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>AdvisorySession</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">LearnerId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">GradeId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">DegreeId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">PreferredFacultyId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">CreatedUtc : DATETIME2(7)</TD></TR><TR><TD ALIGN="LEFT">SubjectsComplete : BIT</TD></TR><TR><TD ALIGN="LEFT">FundingRequested : BIT</TD></TR><TR><TD ALIGN="LEFT">RuleVersion : NVARCHAR(200)</TD></TR></TABLE>>];
Learner -> AdvisorySession [dir=both,arrowtail=tee,arrowhead=crow,label="LearnerId"];
GradeLevel -> AdvisorySession [dir=both,arrowtail=tee,arrowhead=crow,label="GradeId"];
DegreeProgramme -> AdvisorySession [dir=both,arrowtail=tee,arrowhead=crow,label="DegreeId"];
Faculty -> AdvisorySession [dir=both,arrowtail=tee,arrowhead=crow,label="PreferredFacultyId"];
AuditEvent [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>AuditEvent</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">UserId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">Action : NVARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">Detail : NVARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">CreatedUtc : DATETIME2(7)</TD></TR></TABLE>>];
UserAccount -> AuditEvent [dir=both,arrowtail=tee,arrowhead=crow,label="UserId"];
DegreeInterestMapping [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>DegreeInterestMapping</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">DegreeId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">CategoryId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">Weight : DECIMAL(7,2)</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR></TABLE>>];
DegreeProgramme -> DegreeInterestMapping [dir=both,arrowtail=tee,arrowhead=crow,label="DegreeId"];
InterestCategory -> DegreeInterestMapping [dir=both,arrowtail=tee,arrowhead=crow,label="CategoryId"];
DegreeProgramme [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>DegreeProgramme</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">Name : NVARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">FacultyId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">Description : NVARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">MinimumAverage : DECIMAL(7,2)</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR></TABLE>>];
Faculty -> DegreeProgramme [dir=both,arrowtail=tee,arrowhead=crow,label="FacultyId"];
ExportReport [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>ExportReport</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">SessionId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">Path : NVARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">GeneratedUtc : DATETIME2(7)</TD></TR></TABLE>>];
AdvisorySession -> ExportReport [dir=both,arrowtail=tee,arrowhead=crow,label="SessionId"];
Faculty [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>Faculty</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">Name : NVARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR></TABLE>>];
FundingFaculty [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>FundingFaculty</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">FundingId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">FacultyId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR></TABLE>>];
FundingOption -> FundingFaculty [dir=both,arrowtail=tee,arrowhead=crow,label="FundingId"];
Faculty -> FundingFaculty [dir=both,arrowtail=tee,arrowhead=crow,label="FacultyId"];
FundingOption [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>FundingOption</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">Name : NVARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">Type : NVARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">Eligibility : NVARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">Documents : NVARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">ClosingDate : DATE</TD></TR><TR><TD ALIGN="LEFT">Contact : NVARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">Sample : BIT</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR></TABLE>>];
FundingProgramme [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>FundingProgramme</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">FundingId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">DegreeId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR></TABLE>>];
FundingOption -> FundingProgramme [dir=both,arrowtail=tee,arrowhead=crow,label="FundingId"];
DegreeProgramme -> FundingProgramme [dir=both,arrowtail=tee,arrowhead=crow,label="DegreeId"];
GradeLevel [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>GradeLevel</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">Name : NVARCHAR(20)</TD></TR></TABLE>>];
InterestCategory [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>InterestCategory</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">Name : NVARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR></TABLE>>];
InterestQuestion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>InterestQuestion</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">Text : NVARCHAR(400)</TD></TR><TR><TD ALIGN="LEFT">CategoryId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR></TABLE>>];
InterestCategory -> InterestQuestion [dir=both,arrowtail=tee,arrowhead=crow,label="CategoryId"];
Learner [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>Learner</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">Name : NVARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">GradeId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">School : NVARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">Province : NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">Email : NVARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">Phone : NVARCHAR(20)</TD></TR></TABLE>>];
GradeLevel -> Learner [dir=both,arrowtail=tee,arrowhead=crow,label="GradeId"];
LearnerInterestResponse [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>LearnerInterestResponse</B></FONT></TD></TR><TR><TD ALIGN="LEFT">SessionId : INT [PK] [FK]</TD></TR><TR><TD ALIGN="LEFT">QuestionId : INT [PK] [FK]</TD></TR><TR><TD ALIGN="LEFT">Score : INT</TD></TR></TABLE>>];
AdvisorySession -> LearnerInterestResponse [dir=both,arrowtail=tee,arrowhead=crow,label="SessionId"];
InterestQuestion -> LearnerInterestResponse [dir=both,arrowtail=tee,arrowhead=crow,label="QuestionId"];
LearnerSubject [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>LearnerSubject</B></FONT></TD></TR><TR><TD ALIGN="LEFT">SessionId : INT [PK] [FK]</TD></TR><TR><TD ALIGN="LEFT">SubjectId : INT [PK] [FK]</TD></TR><TR><TD ALIGN="LEFT">Mark : DECIMAL(7,2)</TD></TR></TABLE>>];
AdvisorySession -> LearnerSubject [dir=both,arrowtail=tee,arrowhead=crow,label="SessionId"];
Subject -> LearnerSubject [dir=both,arrowtail=tee,arrowhead=crow,label="SubjectId"];
ProgrammeRequirement [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>ProgrammeRequirement</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">DegreeId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">SubjectId : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">MinimumMark : DECIMAL(7,2)</TD></TR><TR><TD ALIGN="LEFT">Mandatory : BIT</TD></TR><TR><TD ALIGN="LEFT">AlternativeGroup : INT</TD></TR><TR><TD ALIGN="LEFT">Note : NVARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR></TABLE>>];
DegreeProgramme -> ProgrammeRequirement [dir=both,arrowtail=tee,arrowhead=crow,label="DegreeId"];
Subject -> ProgrammeRequirement [dir=both,arrowtail=tee,arrowhead=crow,label="SubjectId"];
RecommendationResult [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>RecommendationResult</B></FONT></TD></TR><TR><TD ALIGN="LEFT">SessionId : INT [PK] [FK]</TD></TR><TR><TD ALIGN="LEFT">DegreeId : INT [PK] [FK]</TD></TR><TR><TD ALIGN="LEFT">Outcome : NVARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">SubjectScore : DECIMAL(7,2)</TD></TR><TR><TD ALIGN="LEFT">MarkScore : DECIMAL(7,2)</TD></TR><TR><TD ALIGN="LEFT">InterestScore : DECIMAL(7,2)</TD></TR><TR><TD ALIGN="LEFT">PreferenceScore : DECIMAL(7,2)</TD></TR><TR><TD ALIGN="LEFT">OverallScore : DECIMAL(7,2)</TD></TR><TR><TD ALIGN="LEFT">Explanation : NVARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">Rank : INT</TD></TR></TABLE>>];
AdvisorySession -> RecommendationResult [dir=both,arrowtail=tee,arrowhead=crow,label="SessionId"];
DegreeProgramme -> RecommendationResult [dir=both,arrowtail=tee,arrowhead=crow,label="DegreeId"];
SchemaVersion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>SchemaVersion</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Version : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">AppliedUtc : DATETIME2(7)</TD></TR></TABLE>>];
SessionInterestScore [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>SessionInterestScore</B></FONT></TD></TR><TR><TD ALIGN="LEFT">SessionId : INT [PK] [FK]</TD></TR><TR><TD ALIGN="LEFT">CategoryId : INT [PK] [FK]</TD></TR><TR><TD ALIGN="LEFT">Score : DECIMAL(7,2)</TD></TR></TABLE>>];
AdvisorySession -> SessionInterestScore [dir=both,arrowtail=tee,arrowhead=crow,label="SessionId"];
InterestCategory -> SessionInterestScore [dir=both,arrowtail=tee,arrowhead=crow,label="CategoryId"];
Subject [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>Subject</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">Name : NVARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR></TABLE>>];
UserAccount [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#15303c"><FONT COLOR="white"><B>UserAccount</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">Username : NVARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">PasswordHash : NVARCHAR(300)</TD></TR><TR><TD ALIGN="LEFT">Role : NVARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">Active : BIT</TD></TR><TR><TD ALIGN="LEFT">FailedAttempts : INT</TD></TR><TR><TD ALIGN="LEFT">LockedUntilUtc : DATETIME2(7)</TD></TR></TABLE>>];
}