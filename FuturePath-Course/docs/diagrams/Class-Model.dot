digraph Classes { graph [rankdir=LR,bgcolor="white",pad=.3,nodesep=.35,ranksep=.55]; node [shape=box,style="rounded,filled",fillcolor="#edf5f7",fontname="DejaVu Sans",fontsize=10,color="#17364a"]; edge [fontname="DejaVu Sans",fontsize=9,color="#17766b"];
Main[label="frmMain : Form\nShowStep / GoNext / GoBack"];
Step[label="frmAdvisoryStep : Form\nvirtual RefreshStep / SaveInput"];
Profile[label="frmLearnerProfile : frmAdvisoryStep"];
SubjectForm[label="frmSubjectMarks : frmAdvisoryStep"];
Question[label="QuestionRow : UserControl"];
Draft[label="AdvisoryInput\nLearnerProfile + List<SubjectMark>\n+ List<InterestResponse>"];
Controller[label="AdvisorySessionController\nPreview / Assess / Load"];
Engine[label="RecommendationEngine\nEvaluate / GenerateAlternatives"];
Other[label="AuthenticationController\nAdminMaintenanceController\nReportController"];
Contract[label="IFuturePathStore"];
Store[label="SqlServerStore : DB, IFuturePathStore"];
DAL[label="ReferenceDataDAL / DegreeProgrammeDAL\nAdvisorySessionDAL / FundingDAL\nUserAccountDAL / ReportDAL"];
DB[label="DB\nOpen / Command / ReadData\nSqlDataAdapter -> DataSet -> DataRow"];
SQL[label="SQL Server LocalDB"];
Main -> Step[label="owns child steps"];
Profile -> Step[arrowhead=empty,label="inherits"];
SubjectForm -> Step[arrowhead=empty];
Main -> Draft[label="owns draft"];
Step -> Controller[label="calls shared controller"];
Main -> Other;
Controller -> Engine;
Controller -> Contract;
Other -> Contract;
Store -> Contract[arrowhead=empty,style=dashed];
Store -> DAL[label="delegates"];
DAL -> DB[arrowhead=empty,label="inherits"];
DB -> SQL;
}