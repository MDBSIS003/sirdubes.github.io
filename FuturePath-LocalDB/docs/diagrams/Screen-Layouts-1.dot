digraph G {rankdir=TB;graph[bgcolor="white",nodesep=.45,ranksep=.5,label="Design wireframes — not screenshots or Windows execution evidence",fontname="DejaVu Sans"];node[shape=plain,fontname="DejaVu Sans"];
p0[label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="12" WIDTH="540"><TR><TD ALIGN="LEFT" BGCOLOR="#15303c"><FONT COLOR="white">OVERVIEW — STEP 1</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">NAVY SIDEBAR + FIXED MAIN HEADER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">New advisory session | Staff sign in</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">LocalDB database and advisory disclaimer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">Begin</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">LocalDB status / sample guidance footer</FONT></TD></TR></TABLE>>];
p1[label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="12" WIDTH="540"><TR><TD ALIGN="LEFT" BGCOLOR="#15303c"><FONT COLOR="white">PROFILE — STEP 2</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">NAVY SIDEBAR + FIXED MAIN HEADER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">Name / alias (optional) | Grade 11/12 *</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">School | Province | Email | Phone (optional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">Back | Next</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">LocalDB status / sample guidance footer</FONT></TD></TR></TABLE>>];
p2[label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="12" WIDTH="540"><TR><TD ALIGN="LEFT" BGCOLOR="#15303c"><FONT COLOR="white">SUBJECTS — STEP 3</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">NAVY SIDEBAR + FIXED MAIN HEADER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">Subject * | Mark 0–100 *</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">Add / Update / Remove | Results grid | Complete-list confirmation</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">Back | Next</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">LocalDB status / sample guidance footer</FONT></TD></TR></TABLE>>];
p3[label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="12" WIDTH="540"><TR><TD ALIGN="LEFT" BGCOLOR="#15303c"><FONT COLOR="white">INTERESTS — STEP 4</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">NAVY SIDEBAR + FIXED MAIN HEADER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">Eight database questions</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">Response 1–5 for each question | Missing answer validation</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">Back | Next</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f3f7f9"><FONT COLOR="#15303c">LocalDB status / sample guidance footer</FONT></TD></TR></TABLE>>];
{rank=same;p0;p1;}
{rank=same;p2;p3;}
